<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvTicketName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIP"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvTicketPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Giá: 500,000 VND"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvTicketCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hiện tại: 98 / 100 vé"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvTicketSold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đã bán: 2 vé"
        android:textSize="14sp"
        android:textColor="#FF9800"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvTicketDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mô tả loại vé"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số lượng mới:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNewQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="100"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnUpdateQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cập nhật"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

</LinearLayout>
