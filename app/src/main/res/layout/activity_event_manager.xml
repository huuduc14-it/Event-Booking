<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header: Thống kê nhanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#6200EE"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvManagerEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summer Music Festival 2024"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvTotalSold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đã bán: 120 vé"
                android:textColor="#FFEB3B"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doanh thu: 60tr"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Toolbar: Các chức năng nâng cao (Import/Export/Edit) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 2.1 Edit Event -->
            <Button
                android:id="@+id/btnEditEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:drawableLeft="@android:drawable/ic_menu_edit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_marginEnd="8dp"/>

            <!-- 2.2 Import Excel -->
            <Button
                android:id="@+id/btnImportExcel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import Vé"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <!-- 2.3 Export Excel -->
            <Button
                android:id="@+id/btnExportExcel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất Excel"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <!-- 2.3 Export PDF -->
            <Button
                android:id="@+id/btnExportPDF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất PDF"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách người tham dự"
        android:padding="16dp"
        android:textStyle="bold"
        android:background="#E0E0E0"/>

    <!-- Danh sách khách hàng (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttendees"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>

</LinearLayout>
